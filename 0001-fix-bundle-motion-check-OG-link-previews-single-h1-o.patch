diff --git a/app/scripts/check-bundle-size.mjs b/app/scripts/check-bundle-size.mjs
index 82bb4c1..3c02d74 100644
--- a/app/scripts/check-bundle-size.mjs
+++ b/app/scripts/check-bundle-size.mjs
@@ -505,9 +505,15 @@ const AT = '@' + 'keyframes';
  * instant", and an allowlisted rule that kept running for a reader who asked
  * for stillness would be the exact failure this permission makes possible.
  */
-const ALLOWED_RULES = ['gmm-fill-down', 'gmm-cross-fade'];
-
-const ruleAt = new RegExp(String.raw`${AT}\s+([A-Za-z0-9_-]+)`, 'g');
+// The picker dialog's open (150ms fade + 180ms rise) is a state change inside
+// the 150-300ms window, and the global reduced-motion block in styles.css
+// already sets `animation: none` on everything.
+const ALLOWED_RULES = ['gmm-fill-down', 'gmm-cross-fade', 'pickerFadeIn', 'pickerSlideUp'];
+
+// Component styles are emulated-encapsulated: Angular renames `@keyframes x`
+// to `_ngcontent-%COMP%_x` inside the JS chunk. Strip that scope so the real
+// name is what gets checked, instead of the literal `_ngcontent-`.
+const ruleAt = new RegExp(String.raw`${AT}\s+(?:_ngcontent-%COMP%_)?([A-Za-z0-9_-]+)`, 'g');
 const animated = [];
 const declaredRules = new Set();
 
